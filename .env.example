# Application
APP_NAME=Document Chatbot
DEBUG=false

# Database (overridden by docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# JWT - CHANGE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100


# Vertex AI (for GCP VM with Application Default Credentials — no API key needed)
# Set GOOGLE_GENAI_USE_VERTEX=true and configure project/location to use Vertex AI.
# Leave unset (or false) to use GOOGLE_API_KEY instead.
GOOGLE_GENAI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
